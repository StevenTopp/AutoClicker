<Window x:Class="AutoClicker.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IndicatorWindow" Height="60" Width="60"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False">
    <Window.Resources>
        <!-- Style 3 Pulsing Animation -->
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="style3Glow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.85"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="0.85"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="style3Glow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.85"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="0.85"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="style3Glow" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.95"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="0.5"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Hover Highlight Scale Animation -->
        <Storyboard x:Key="HighlightAnimation">
            <DoubleAnimation Storyboard.TargetName="scaleTrans" Storyboard.TargetProperty="ScaleX" To="1.35" Duration="0:0:0.15" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="scaleTrans" Storyboard.TargetProperty="ScaleY" To="1.35" Duration="0:0:0.15" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Grid x:Name="MainGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Height="60" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="scaleTrans" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <!-- Style 1: Solid Vibrant Red Dot -->
        <Grid x:Name="ContainerStyle1" Visibility="Collapsed">
            <Border Width="26" Height="26" Background="#EF4444" CornerRadius="13" BorderBrush="White" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.4" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
            </Border>
        </Grid>

        <!-- Style 2: Hollow High-Precision Red Ring (Default Option 2) -->
        <Grid x:Name="ContainerStyle2" Visibility="Visible">
            <Border Width="28" Height="28" Background="#25EF4444" CornerRadius="14" BorderBrush="#EF4444" BorderThickness="2"/>
        </Grid>

        <!-- Style 3: Glowing Radial Neon Dot (Pulsing) -->
        <Grid x:Name="ContainerStyle3" Visibility="Collapsed">
            <Ellipse x:Name="style3Glow" Width="32" Height="32" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FFEE4444" Offset="0"/>
                        <GradientStop Color="#88FF0000" Offset="0.3"/>
                        <GradientStop Color="#00FF0000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Style 4: Minimalist Crosshair Target -->
        <Grid x:Name="ContainerStyle4" Visibility="Collapsed" Width="30" Height="30">
            <Ellipse Width="24" Height="24" Stroke="#EF4444" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Line X1="0" Y1="15" X2="30" Y2="15" Stroke="#EF4444" StrokeThickness="1"/>
            <Line X1="15" Y1="0" X2="15" Y2="30" Stroke="#EF4444" StrokeThickness="1"/>
        </Grid>

        <!-- Number Indicator in the exact center -->
        <TextBlock x:Name="TxtNumber" Text="1" Foreground="White" FontSize="10" FontWeight="ExtraBold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="0"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
